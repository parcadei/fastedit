{
  "language": "yaml",
  "ext": "yaml",
  "filename": "original.yaml",
  "symbol_semantics": "block-mapping pairs (keys), named by the key (quotes stripped); nested mappings' pairs become nested symbols",
  "ops": [
    {
      "op": "insert_after",
      "symbol": "version",
      "snippet": "license: MIT\n",
      "path": "fast_path",
      "prepend_signature_lines": 0,
      "oracle": {
        "anchor_start_line": 2,
        "anchor_end_line": 2
      },
      "expected": "expected_insert_after_version.yaml"
    },
    {
      "op": "replace_symbol",
      "symbol": "version",
      "snippet": "version: 0.6.0\n",
      "path": "direct_swap",
      "prepend_signature_lines": 0,
      "oracle": {
        "start_line": 2,
        "end_line": 2
      },
      "expected": "expected_replace_symbol_version.yaml"
    },
    {
      "op": "delete_symbol",
      "symbol": "port",
      "snippet": null,
      "path": null,
      "prepend_signature_lines": 0,
      "oracle": {
        "start_line": 5,
        "end_line": 5
      },
      "expected": "expected_delete_symbol_port.yaml"
    }
  ],
  "gigo": {
    "original": "original_gigo.yaml",
    "defect": "unclosed flow sequence in an unrelated key — preserved byte-exact",
    "defect_lines": [
      5,
      6
    ],
    "op": {
      "op": "insert_after",
      "symbol": "database",
      "snippet": "cache:\n  enabled: true\n",
      "path": "fast_path",
      "prepend_signature_lines": 0,
      "oracle": {
        "anchor_start_line": 3,
        "anchor_end_line": 4
      },
      "expected": "expected_gigo_database.yaml"
    }
  }
}
